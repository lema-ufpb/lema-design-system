{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ds-nav-user",
  "title": "Nav User",
  "description": "A user profile dropdown menu for navigation headers, built on DropdownMenu and Avatar.",
  "registryDependencies": [
    "button",
    "dropdown-menu",
    "avatar",
    "skeleton"
  ],
  "files": [
    {
      "path": "components/ds/nav-user.tsx",
      "content": "\"use client\"\n\nimport { ChevronsUpDown } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { Skeleton } from \"@/components/ui/skeleton\"\nimport { cn } from \"@/lib/utils\"\nimport type React from \"react\"\n\nexport interface UserMenuProps {\n  user?: UserMenuData\n  groups?: UserMenuItem[][]\n  /** Show animated skeleton in place of the user button while data loads */\n  loading?: boolean\n}\n\nexport interface UserMenuData {\n  name: string\n  email: string\n  avatarUrl?: string\n}\n\nexport interface UserMenuItem {\n  id: string\n  label: string\n  /** Pre-rendered icon node — pass JSX e.g. <Settings className=\"size-4\" /> */\n  icon?: React.ReactNode\n  shortcut?: string\n  onClick?: () => void\n  variant?: \"default\" | \"destructive\"\n}\n\nexport function NavUser({ user, groups = [], loading = false }: UserMenuProps) {\n  if (loading || !user) {\n    return (\n      <div\n        data-slot=\"nav-user-skeleton\"\n        className=\"flex h-9 items-center gap-2 px-2\"\n      >\n        <Skeleton className=\"size-7 shrink-0 rounded-lg\" />\n        <div className=\"hidden flex-col gap-1 md:flex\">\n          <Skeleton className=\"h-3 w-20 rounded-md\" />\n          <Skeleton className=\"h-2.5 w-28 rounded-md\" />\n        </div>\n        <ChevronsUpDown className=\"ml-1 size-4 shrink-0 text-muted-foreground opacity-30\" />\n      </div>\n    )\n  }\n\n  const initials = user.name\n    .split(\" \")\n    .map((n) => n[0])\n    .join(\"\")\n    .slice(0, 2)\n    .toUpperCase()\n\n  return (\n    <DropdownMenu data-slot=\"nav-user\">\n      <DropdownMenuTrigger asChild>\n        <Button\n          data-slot=\"nav-user-trigger\"\n          variant=\"ghost\"\n          className=\"flex h-9 items-center gap-2 px-2\"\n        >\n          <Avatar data-slot=\"nav-user-avatar\" className=\"size-7 rounded-lg\">\n            <AvatarImage src={user.avatarUrl ?? \"\"} alt={user.name} />\n            <AvatarFallback className=\"rounded-lg text-xs\">\n              {initials}\n            </AvatarFallback>\n          </Avatar>\n          <div\n            data-slot=\"nav-user-info\"\n            className=\"hidden grid-cols-1 text-left text-sm leading-tight md:grid\"\n          >\n            <span className=\"truncate font-medium\">{user.name}</span>\n            <span className=\"truncate text-xs text-muted-foreground\">\n              {user.email}\n            </span>\n          </div>\n          <ChevronsUpDown className=\"ml-1 size-4 text-muted-foreground\" />\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent\n        className=\"min-w-56 rounded-lg\"\n        side=\"bottom\"\n        align=\"end\"\n        sideOffset={4}\n      >\n        <DropdownMenuLabel className=\"p-0 font-normal\">\n          <div className=\"flex items-center gap-2 px-1 py-1.5 text-left text-sm\">\n            <Avatar data-slot=\"nav-user-avatar\" className=\"size-8 rounded-lg\">\n              <AvatarImage src={user.avatarUrl ?? \"\"} alt={user.name} />\n              <AvatarFallback className=\"rounded-lg\">{initials}</AvatarFallback>\n            </Avatar>\n            <div\n              data-slot=\"nav-user-info\"\n              className=\"grid flex-1 text-left text-sm leading-tight\"\n            >\n              <span className=\"truncate font-medium\">{user.name}</span>\n              <span className=\"truncate text-xs text-muted-foreground\">\n                {user.email}\n              </span>\n            </div>\n          </div>\n        </DropdownMenuLabel>\n        {groups.map((group, i) => (\n          <div key={i}>\n            <DropdownMenuSeparator />\n            <DropdownMenuGroup>\n              {group.map((item) => {\n                return (\n                  <DropdownMenuItem\n                    data-slot=\"nav-user-item\"\n                    key={item.id}\n                    onClick={item.onClick}\n                    className={cn(\n                      item.variant === \"destructive\" &&\n                        \"text-destructive focus:text-destructive\"\n                    )}\n                  >\n                    {item.icon}\n                    <span className=\"flex-1\">{item.label}</span>\n                    {item.shortcut && (\n                      <DropdownMenuShortcut>\n                        {item.shortcut}\n                      </DropdownMenuShortcut>\n                    )}\n                  </DropdownMenuItem>\n                )\n              })}\n            </DropdownMenuGroup>\n          </div>\n        ))}\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/ui/ds-nav-user.tsx"
    }
  ],
  "type": "registry:ui"
}